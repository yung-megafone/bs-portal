# B.S. Portal local development environment template.
# Copy this file to .env and replace placeholder values locally.
# .env is ignored by Git; never commit real credentials or production secrets.

DJANGO_DEBUG=True
DJANGO_SECRET_KEY=change-me-local-only
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# MySQL/InnoDB -- the portal does not use SQLite as a fallback.
MYSQL_DATABASE=bs_portal_dev
MYSQL_USER=bs_portal
MYSQL_PASSWORD=CHANGE_ME
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# Optional: defaults to <repo>/data/asset_media when omitted.
# BAM_MEDIA_ROOT=C:\path\to\bs-portal-data\asset_media

# Optional isolated test database credentials. If omitted, config.settings.test
# inherits the MYSQL_* values above.
# TEST_MYSQL_DATABASE=bs_portal_test
# TEST_MYSQL_USER=bs_portal
# TEST_MYSQL_PASSWORD=CHANGE_ME
# TEST_MYSQL_HOST=127.0.0.1
# TEST_MYSQL_PORT=3306
