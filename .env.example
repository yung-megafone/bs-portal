# B.S. Portal local development example
# Never commit a real .env file.

DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=replace-this-with-a-long-random-local-secret
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
DJANGO_DEBUG=true

MYSQL_DATABASE=bs_portal_dev
MYSQL_USER=bs_portal
MYSQL_PASSWORD=change-me
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# Staging/production values are configured in cPanel environment variables,
# not committed here.
